# Copy to backend/.env and fill in. Never commit the real .env file.
# Generate a key with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change_me
DB_NAME=
DB_USER=
DB_PWD=
DB_HOST=localhost
DB_PORT=5432

# Optional: DJANGO_DEBUG defaults to False; set True for local development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Hosted deployments: set DATABASE_URL (postgresql://...) instead of the DB_* values above.
# DATABASE_URL=
